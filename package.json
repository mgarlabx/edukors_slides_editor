{
  "name": "edukors-slides-editor",
  "productName": "Edukors Slides Editor",
  "version": "1.0.0",
  "private": true,
  "description": "Desktop HTML presentation editor",
  "author": {
    "name": "Edukors",
    "url": "https://edukors.org"
  },
  "homepage": "https://github.com/mgarlabx/edukors_slides_editor",
  "repository": {
    "type": "git",
