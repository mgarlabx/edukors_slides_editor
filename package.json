{
  "name": "edukors-slides-editor",
  "productName": "Edukors Slides Editor",
  "version": "1.0.0",
  "private": true,
  "description": "Desktop HTML presentation editor",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node scripts/start.mjs",
    "dev": "node scripts/build.mjs && node scripts/start.mjs",
    "test": "node scripts/test.mjs",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "test:e2e": "node scripts/e2e.mjs",
    "package:mac": "node scripts/package-mac.mjs",
    "perf": "node scripts/perf.mjs",
    "test:canvas": "node scripts/test-canvas.mjs",
    "test:inheritance": "node scripts/test-inheritance.mjs",
    "test:master-editor": "node scripts/test-master-editor.mjs",
    "test:poll": "node scripts/e2e.mjs --poll",
    "test:poll:server": "node scripts/e2e.mjs --poll-server",
    "test:poll:live": "node scripts/e2e.mjs --poll-live",
    "sync:poll": "node scripts/sync-poll-server.mjs"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/node": "22.13.9",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "electron": "44.3.0",
    "esbuild": "0.25.10",
    "playwright": "1.63.0",
    "terser": "5.51.2",
    "typescript": "5.9.3"
  },
  "license": "MIT"
}
